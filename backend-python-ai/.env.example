# QueryX Python AI Service - Environment Variables

# Service Host & Port
APP_NAME="QueryX AI Intelligence Service"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Security: Service-to-Service API Key (Optional for local dev, enforced in production)
SERVICE_API_KEY=""

# Allowed CORS Origins (for local testing & Spring Boot backend)
ALLOWED_ORIGINS="http://localhost:8080,http://127.0.0.1:8080"
